---
interface Props {
	align?: "left" | "right";
}

const { align = "left" } = Astro.props;
---

<div
	class={`flex items-center  text-2xl font-cormorant  ${align === "right" ? "flex-row-reverse" : ""}`}>
	<div class='flex flex-col items-center'>
		<span class='w-[110px] h-px bg-purple'></span>
		<span><slot /></span>
		<span class='w-[110px] h-px bg-purple'></span>
	</div>
</div>
