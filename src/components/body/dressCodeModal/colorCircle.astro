---
interface ColorProps {
	color: string;
	borderColor: boolean;
}
const { color, borderColor }: ColorProps = Astro.props as ColorProps;
---

{
	borderColor ? (
		<div
			class='rounded-full w-10 h-10 border border-[#555555]'
			style={`background-color: ${color};`}
		/>
	) : (
		<div class='rounded-full w-10 h-10' style={`background-color: ${color};`} />
	)
}
