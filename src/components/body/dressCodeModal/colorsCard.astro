---
interface ColorCardProps {
	cardTitle: string;
	cardDescription: string;
	colorListOne: string[];
	wrapperTextOne: string;
	colorListTwo: string[];
	wrapperTextTwo: string;
	colorListThree?: string[];
	wrapperTextThree?: string;
    borderOne: boolean;
    borderTwo: boolean;
    borderThree?: boolean;
}
const {
	colorListOne,
	wrapperTextOne,
	colorListTwo,
	wrapperTextTwo,
	colorListThree,
	wrapperTextThree,
	cardTitle,
	cardDescription,
    borderOne,
    borderTwo,
    borderThree
}: ColorCardProps = Astro.props as ColorCardProps;

import ColorWrapper from "./colorWrapper.astro";
---

{
	colorListThree ? (
		<section class='my-12'>
			<p class='font-cormorant text-28 text-center'>{cardTitle}</p>
			<p class='font-cormorant text-center text-[20px]'>{cardDescription}</p>
			<ColorWrapper colorList={colorListOne} wrapperText={wrapperTextOne} border={borderOne} />
			<ColorWrapper colorList={colorListTwo} wrapperText={wrapperTextTwo} border={borderTwo} />
			<ColorWrapper colorList={colorListThree} wrapperText={wrapperTextThree} border={borderThree} />
		</section>
	) : (
		<section class='my-12'>
			<p class='font-cormorant text-28 text-center'>{cardTitle}</p>
			<p class='font-cormorant text-center text-[20px]'>{cardDescription}</p>
			<ColorWrapper colorList={colorListOne} wrapperText={wrapperTextOne} border={borderOne}/>
			<ColorWrapper colorList={colorListTwo} wrapperText={wrapperTextTwo} border={borderTwo}/>
		</section>
	)
}
