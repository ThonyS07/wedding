---
const { title, options } = Astro.props as {
  title: string;
  options: string[];
};
---
<div class='flex flex-col gap-4 items-center justify-center text-center'>   
    <p class='font-alex text-[28px] text-purple max-w-xl'>{title}</p>
    {options.map((option) => (
        <p class='font-cormorant text-[20px] max-w-xl'>{option}</p>
    ))}
</div>