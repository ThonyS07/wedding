---
import OutfitsInspirationImage from "../../../assets/dressCodeModalOutfitsInspiration.webp";
---

<div
	class='flex flex-col items-center justify-center text-center lg:w-full gap-4'>
	<p class='font-cormorant text-28'>Inspiración para tus outfits</p>
	<p class='text-[20px] font-cormorant'>
		Te compartimos ideas de como asistir a nuestra boda.
	</p>
	<img
		src={OutfitsInspirationImage.src}
		alt='Imagen de la inspiración de outfits para el dress code'
		class='w-full h-auto rounded-2xl'
	/>
</div>
