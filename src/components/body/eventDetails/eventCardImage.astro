---
interface ImageProps {
	cardImages: {
		mobile: string;
		tablet: string;
		desktop: string;
		desktopLarge: string;
	};
	cardTitle: string;
}
const { cardImages, cardTitle } = Astro.props as ImageProps;
---

<div class="w-full max-w-70 h-90 md:max-w-56 md:h-70 lg:max-w-70 lg:h-90 xl:max-w-75 xl:h-[385.71px] rounded-t-full ">
	{cardImages	 &&(
		<picture>
		<source
			media="(min-width: 1440px)"
			srcset={cardImages.desktopLarge}
			/>
		<source
			media="(min-width: 1280px)"
			srcset={cardImages.desktop}
			/>
		<source
			media="(min-width: 768px)"
			srcset={cardImages.tablet}
			/>
		<img
			class="w-full h-full rounded-t-full"
			src={cardImages.mobile}
			alt={cardTitle}
			/>
	</picture>
		)}
</div>
