---
import { Button } from "../../button";
import EventCardImage from "./eventCardImage.astro";

interface eventCardProps {
	cardImages: {
		mobile: string;
		tablet: string;
		desktop: string;
		desktopLarge: string;
	};
	cardTitle: string;
	cardDescription: string;
	cardAction: string;
	className?: string;
	buttonText?: string;
}

const { cardImages, cardTitle, cardDescription, cardAction, className, buttonText} =
	Astro.props as eventCardProps;
---

<div
	class={`flex flex-col w-full max-w-85.75 h-161 sm:mb-12 md:mb-0 md:max-w-56 md:h-160 lg:max-w-[357.3px] lg:h-166.25 xl:max-w-75 xl:h-[690.71px] items-center justify-between ${className || ''}`}>
	<EventCardImage cardImages={cardImages} cardTitle={cardTitle} />
	<p
		class='text-[#555555] sm:text-detailtitlemobile lg:text-detailtitledesktop font-ephesis'>
		{cardTitle}
	</p>
	<p
		class='font-cormorant
            text-[24px]
            text-center
            leading-tight
            min-h-[96px]
            flex
            items-center
            px-2'>
		{cardDescription}
	</p>
	<Button
		text={buttonText || 'Ver detalles'}
		color='white'
		textColor='purple'
		action={cardAction}
		isModal={true}
		client:load
	/>
</div>
