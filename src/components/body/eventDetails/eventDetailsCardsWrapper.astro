---
import EventDetailsCard from "./eventDetailsCard.astro";
import UbicacionImageMobile from "../../../assets/ubicacionImageMobile.png";
import UbicacionImageTablet from "../../../assets/ubicacionImageTablet.png";
import UbicacionImageDesktop from "../../../assets/ubicacionImageDesktop.png";
import UbicacionImageDesktopLarge from "../../../assets/ubicacionImageDesktopLarge.png";
import DressCodeImageMobile from "../../../assets/dressCodeImageMobile.png";
import DressCodeImageTablet from "../../../assets/dressCodeImageTablet.png";
import DressCodeImageDesktop from "../../../assets/dressCodeImageDesktop.png";
import DressCodeImageDesktopLarge from "../../../assets/dressCodeImageDesktopLarge.png";
import ItinerarioImageMobile from "../../../assets/itinerarioImageMobile.png";
import ItinerarioImageTablet from "../../../assets/itinerarioImageTablet.png";
import ItinerarioImageDesktop from "../../../assets/itinerarioImageDesktop.png";
import ItinerarioImageDesktopLarge from "../../../assets/itinerarioImageDesktopLarge.png";
const ubicacionImages = {
	mobile: UbicacionImageMobile.src,
	tablet: UbicacionImageTablet.src,
	desktop: UbicacionImageDesktop.src,
	desktopLarge: UbicacionImageDesktopLarge.src,
};
const dressCodeImages = {
	mobile: DressCodeImageMobile.src,
	tablet: DressCodeImageTablet.src,
	desktop: DressCodeImageDesktop.src,
	desktopLarge: DressCodeImageDesktopLarge.src,
};
const itinerarioImages = {
	mobile: ItinerarioImageMobile.src,
	tablet: ItinerarioImageTablet.src,
	desktop: ItinerarioImageDesktop.src,
	desktopLarge: ItinerarioImageDesktopLarge.src,
};
---

<div class='flex flex-col md:flex-row justify-center gap-6'>
	<EventDetailsCard
		cardImages={ubicacionImages}
		cardTitle='Ubicación'
		cardDescription='Consulta la ubicación antes de asistir: Villa Chabelita, Pachacamac – Lima.'
		cardAction='#mapModal'
	/>

	<EventDetailsCard
		cardImages={dressCodeImages}
		cardTitle='Dress code'
		cardDescription='Revisa el código de vestimenta para mantener la armonía visual del evento.'
		cardAction='#dressCodeModal'
	/>

	<EventDetailsCard
		cardImages={itinerarioImages}
		cardTitle='Itinerario'
		cardDescription='Conoce el itinerario completo para acompañarnos en cada momento especial.'
		cardAction='#itineraryModal'
	/>
</div>

<script>
	document.addEventListener("click", (e) => {
		const target = e.target as HTMLElement;

		const link = target.closest('a[href^="#"]') as HTMLAnchorElement | null;

		if (!link) return;

		const href = link.getAttribute("href");

		if (!href) return;

		const dialog = document.querySelector<HTMLDialogElement>(href);

		if (!dialog) return;

		e.preventDefault();
		dialog.showModal();
	});
</script>
