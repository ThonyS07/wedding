---
import EventDetailsCard from "./eventDetailsCard.astro";
import CeremoniaImageMobile from "../../../assets/eventDetailsImages/ceremoniaMobile.webp";
import CeremoniaImageTablet from "../../../assets/eventDetailsImages/ceremoniaTablet.webp";
import CeremoniaImageDesktop from "../../../assets/eventDetailsImages/ceremoniaDesktop.webp";
import CeremoniaImageDesktopLarge from "../../../assets/eventDetailsImages/ceremoniaDesktopLarge.webp";
import RecepcionImageMobile from "../../../assets/eventDetailsImages/recepcionMobile.webp";
import RecepcionImageTablet from "../../../assets/eventDetailsImages/recepcionTablet.webp";
import RecepcionImageDesktop from "../../../assets/eventDetailsImages/recepcionDesktop.webp";
import RecepcionImageDesktopLarge from "../../../assets/eventDetailsImages/recepcionDesktopLarge.webp";
import DressCodeImageMobile from "../../../assets/eventDetailsImages/dressCodeMobile.webp";
import DressCodeImageTablet from "../../../assets/eventDetailsImages/dressCodeTablet.webp";
import DressCodeImageDesktop from "../../../assets/eventDetailsImages/dressCodeDesktop.webp";
import DressCodeImageDesktopLarge from "../../../assets/eventDetailsImages/dressCodeDesktopLarge.webp";
import ItinerarioImageMobile from "../../../assets/eventDetailsImages/itineraryMobile.webp";

const ceremoniaImages = {
	mobile: CeremoniaImageMobile.src,
	tablet: CeremoniaImageTablet.src,
	desktop: CeremoniaImageDesktop.src,
	desktopLarge: CeremoniaImageDesktopLarge.src,
};
const recepcionImages = {
	mobile: RecepcionImageMobile.src,
	tablet: RecepcionImageTablet.src,
	desktop: RecepcionImageDesktop.src,
	desktopLarge: RecepcionImageDesktopLarge.src,
};
const dressCodeImages = {
	mobile: DressCodeImageMobile.src,
	tablet: DressCodeImageTablet.src,
	desktop: DressCodeImageDesktop.src,
	desktopLarge: DressCodeImageDesktopLarge.src,
};
const itinerarioImages = {
	mobile: ItinerarioImageMobile.src,
};
---

<div class='flex flex-col md:flex-row justify-center gap-6'>
	<EventDetailsCard
		cardImages={ceremoniaImages}
		cardTitle='Ceremonia'
		cardDescription='Parroquia La Resurrección del Señor, Los vientos 26, San Bartolo - Lima.'
		cardAction='#ceremoniaMapModal'
		buttonText='Ver ubicación'
	/>

	<EventDetailsCard
		cardImages={recepcionImages}
		cardTitle='Recepción'
		cardDescription='Casa campo Villa Chabelita, Pachacamac - Lima.'
		cardAction='#recepcionMapModal'
		buttonText='Ver ubicación'
	/>
	<EventDetailsCard
		cardImages={dressCodeImages}
		cardTitle='Dress code'
		cardDescription='Código de vestimenta para mantener la armonía visual del evento.'
		cardAction='#dressCodeModal'
	/>

	<EventDetailsCard
		cardImages={itinerarioImages}
		cardTitle='Itinerario'
		cardDescription='Conoce el itinerario completo para acompañarnos en cada momento especial.'
		cardAction='#itineraryModal'
		className=' md:hidden'
	/>
</div>

<script>
	document.addEventListener("click", (e) => {
		const target = e.target;

		if (!(target instanceof Element)) return;

		const link = target.closest("a[data-modal]");

		if (!(link instanceof HTMLAnchorElement)) return;

		const href = link.getAttribute("href");

		if (!href) return;

		const dialog = document.querySelector(href);

		if (!(dialog instanceof HTMLDialogElement)) return;

		e.preventDefault();
		dialog.showModal();
	});
</script>
