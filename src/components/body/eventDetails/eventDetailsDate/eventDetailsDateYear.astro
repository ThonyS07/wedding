---
interface Props {
	year: string | number;
}

const { year } = Astro.props;
---

<div class='year-row'>
	<span class='line'></span>
	<span class='year'>{year}</span>
	<span class='line'></span>
</div>

<style>
	.year-row {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.year {
		font-size: 18px;
	}

	.line {
		width: 80px;
		height: 1px;
		background: #7a1c73;
	}
</style>
