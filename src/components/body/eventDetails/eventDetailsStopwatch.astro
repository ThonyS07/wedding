---
import RegularCormorantText from "../../regularCormorantText.astro";
---

<div class='flex flex-col items-center justify-center my-8'>
	<RegularCormorantText>
		Estamos a muy poco de empezar nuestro gran día
	</RegularCormorantText>

	<div class='flex gap-4 mt-4 text-center text-[#7b8175]' id='countdown'>
		<div class='flex flex-col items-center'>
			<span
				class='font-playball text-[42px] text-purple md:text-6xl font-semibold'
				id='days'>00</span
			>
			<span
				class='font-ephesis text-[20px] text-gray md:text-xs uppercase tracking-[0.2em] mt-2'
				>Días</span
			>
		</div>
		<span class='font-ephesis text-[42px] md:text-6xl font-semibold'>:</span>
		<div class='flex flex-col items-center'>
			<span
				class='font-playball text-[42px] text-purple md:text-6xl font-semibold'
				id='hours'>00</span
			>
			<span
				class='font-ephesis text-[20px] text-gray md:text-xs uppercase tracking-[0.2em] mt-2'
				>Hs</span
			>
		</div>
		<span class='font-ephesis text-[42px] md:text-6xl font-semibold'>:</span>
		<div class='flex flex-col items-center'>
			<span
				class='font-playball text-[42px] text-purple md:text-6xl font-semibold'
				id='minutes'>00</span
			>
			<span
				class='font-ephesis text-[20px] text-gray md:text-xs uppercase tracking-[0.2em] mt-2'
				>Min</span
			>
		</div>
		<span
			class='font-playball text-[42px] text-purple md:text-6xl font-semibold'
			>:</span
		>
		<div class='flex flex-col items-center'>
			<span
				class='font-ephesis text-purple text-[42px] md:text-6xl font-semibold'
				id='seconds'>00</span
			>
			<span
				class='font-ephesis text-[20px] text-gray md:text-xs uppercase tracking-[0.2em] mt-2'
				>Seg</span
			>
		</div>
	</div>
</div>

<script>
	const targetDate = new Date("2026-09-19T00:00:00").getTime();

	function updateCountdown() {
		const now = new Date().getTime();
		const difference = targetDate - now;

		if (difference > 0) {
			const days = Math.floor(difference / (1000 * 60 * 60 * 24));
			const hours = Math.floor(
				(difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
			);
			const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
			const seconds = Math.floor((difference % (1000 * 60)) / 1000);

			const daysEl = document.getElementById("days");
			const hoursEl = document.getElementById("hours");
			const minutesEl = document.getElementById("minutes");
			const secondsEl = document.getElementById("seconds");

			if (daysEl && hoursEl && minutesEl && secondsEl) {
				daysEl.innerText = days.toString().padStart(2, "0");
				hoursEl.innerText = hours.toString().padStart(2, "0");
				minutesEl.innerText = minutes.toString().padStart(2, "0");
				secondsEl.innerText = seconds.toString().padStart(2, "0");
			}
		}
	}

	// Update the countdown every 1 second
	setInterval(updateCountdown, 1000);
	// Initial call to display countdown immediately
	updateCountdown();
</script>
