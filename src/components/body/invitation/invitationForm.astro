---
const scriptURL = import.meta.env.PUBLIC_GOOGLE_APP_URL;
---

<form id='rsvp-form' class='flex flex-col gap-6'>
	<div class='flex flex-col'>
		<label for='nombre' class='mb-2'>Nombre</label>
		<input
			class='bg-[#FFFFFF] h-14 px-4'
			type='text'
			id='nombre'
			name='nombre'
			required
		/>
	</div>

	<div class='flex flex-col'>
		<label for='telefono' class='mb-2'>Número de teléfono</label>
		<input
			class='bg-[#FFFFFF] h-14 px-4'
			type='tel'
			id='telefono'
			name='telefono'
			required
		/>
	</div>

	<div class='flex flex-col mb-2'>
		<label class='mb-2'>Confirmación de asistencia</label>

		<div class='flex flex-col gap-2'>
			<label class='flex items-center gap-2 cursor-pointer'>
				<input
					type='radio'
					name='asistencia'
					value='Sí asistiré'
					class='w-5 h-5 accent-purple'
					required
				/>
				<span>Sí asistiré</span>
			</label>

			<label class='flex items-center gap-2 cursor-pointer'>
				<input
					type='radio'
					name='asistencia'
					value='No asistiré'
					class='w-5 h-5 accent-purple'
					required
				/>
				<span>No podré asistir</span>
			</label>
		</div>
	</div>

	<button
		id='submit-button'
		type='submit'
		class='button bg-purple px-8 h-12 rounded-lg border-2 border-purple text-white inline-flex items-center justify-center cursor-pointer font-lato text-[18px] mt-2 disabled:opacity-70 transition-opacity'>
		Enviar confirmación
	</button>

	<p id='form-message' class='hidden text-center mt-2 font-lato text-[16px]'>
	</p>
</form>

<script define:vars={{ scriptURL }}>
	const form = document.getElementById("rsvp-form");
	const submitButton = document.getElementById("submit-button");
	const formMessage = document.getElementById("form-message");

	if (
		!(form instanceof HTMLFormElement) ||
		!(submitButton instanceof HTMLButtonElement) ||
		!(formMessage instanceof HTMLParagraphElement)
	) {
		console.error("No se encontraron los elementos del formulario.");
	} else {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();

			if (!scriptURL) {
				alert("No se encontró la variable PUBLIC_GOOGLE_APP_URL.");
				return;
			}

			submitButton.disabled = true;
			submitButton.textContent = "Enviando...";

			try {
				const formData = new FormData(form);
				const data = new URLSearchParams();

				for (const [key, value] of formData.entries()) {
					data.append(key, String(value));
				}

				data.append("fecha", new Date().toLocaleDateString("es-PE"));

				const response = await fetch(scriptURL, {
					method: "POST",
					body: data,
					headers: {
						"Content-Type": "application/x-www-form-urlencoded",
					},
					mode: "cors",
				});

				if (!response.ok) {
					throw new Error(`HTTP ${response.status}`);
				}

				form.reset();

				formMessage.textContent = "¡Gracias por confirmar tu asistencia!";
				formMessage.classList.remove("hidden", "text-red-500", "text-blue-500");
				formMessage.classList.add("text-green-600");
			} catch (error) {
				console.error(error);

				formMessage.textContent =
					"No fue posible enviar la confirmación. Inténtalo nuevamente.";
				formMessage.classList.remove(
					"hidden",
					"text-green-600",
					"text-blue-500",
				);
				formMessage.classList.add("text-red-500");
			} finally {
				submitButton.disabled = false;
				submitButton.textContent = "Enviar confirmación";
			}
		});
	}
</script>
