		<img
			class='w-full h-full object-cover object-center'
			src={ourHistoryImageTablet.src}
			alt='mobile-cover-image'
		/>
	</div>
	<div class='w-full h-[374px] md:hidden lg:block lg:h-[817px] lg:w-[652px] xl:h-[924px] xl:w-[732px]'>
		<img
			class='w-full h-full object-cover object-center'
			src={invitationImage.src}
			alt='mobile-cover-image'
		/>
	</div>
</div>

