---
import invitationImage from "../../../assets/2.jpg";


const images = {
	mobile: invitationImage.src,
	// tablet: tabletInvitationImage.src,
	desktop: invitationImage.src,
	desktopLarge: invitationImage.src,
};
---

<div class=' inset-0 w-full h-full'>
	<div class='w-full h-full block md:hidden'>
		<img
			class='w-full h-full object-cover object-center'
			src={images.mobile}
			alt='mobile-cover-image'
		/>
	</div>
	<!-- <div class='w-full h-full hidden md:block lg:hidden'>
		<img
			class='w-full h-full object-cover object-center'
			src={images.tablet}
			alt='tablet-cover-image'
		/>
	</div> -->
	<div class='w-full h-full hidden lg:block xl:hidden'>
		<img
			class='w-full h-full object-cover object-center'
			src={images.desktop}
			alt='desktop-cover-image'
		/>
	</div>
	<div class='w-full h-full hidden xl:block'>
		<img
			class='w-full h-full object-cover object-center'
			src={images.desktopLarge}
			alt='desktop-large-cover-image'
		/>
	</div>
</div>
