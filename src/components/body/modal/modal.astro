---
import ModalHeader from "./modalHeader.astro";
import ModalCloseButton from "./modalCloseButton.astro";

interface Props {
	id: string;
	title: string;
	subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<dialog
	id={id}
	class='lg:backdrop:bg-black/60
		rounded-3xl
		w-full
		lg:w-[700px]
		lg:h-[610px]
		h-full
		lg:max-h-[90vh]
		m-auto
		fixed
		inset-0
		overflow-hidden
		bg-[#FFFFFF]'>
	<div class='flex flex-col max-h-[90vh] h-full'>
		<!-- Header Fijo -->
		<div class='shrink-0 p-4 sm:px-8 sm:pt-6 pb-0'>
			<ModalHeader />
		</div>
		<div class='overflow-y-auto flex-1 flex flex-col gap-4 p-4 sm:px-8 sm:pb-8'>
			<div class='text-center'>
				<h2
					class='font-ephesis text-detailtitlemobile lg:text-detailtitledesktop text-[#555555]'>
					{title}
				</h2>

				{
					subtitle && (
						<p class='font-cormorant text-lg mt-2 text-gray-500'>{subtitle}</p>
					)
				}
			</div>

			<div class='mt-8'>
				<slot />
			</div>

			<!-- Siempre aparece -->
			<ModalCloseButton />
		</div>
	</div>
</dialog>

<script>
	document.addEventListener("click", (event) => {
		const target = event.target;

		if (!(target instanceof Element)) return;

		const button = target.closest(".close-modal-btn");

		if (!(button instanceof HTMLButtonElement)) return;

		const dialog = button.closest("dialog");

		if (dialog instanceof HTMLDialogElement) {
			dialog.close();
		}
	});
</script>
