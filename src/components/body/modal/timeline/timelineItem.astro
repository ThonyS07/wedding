---
interface Props {
	hour: string;
	title: string;
	icon: string;
}

const { hour, title, icon } = Astro.props;
---

<div class='flex flex-col items-center w-full max-w-32'>
	<img src={icon} class='w-14 h-14 mb-3' />

	<p class='font-cormorant text-lg'>
		{hour}
	</p>

	<p class='font-cormorant text-gray-600 text-center'>
		{title}
	</p>
</div>
