---
interface Props {
	isLast?: boolean;
}

const { isLast = false } = Astro.props;
---

<div class='flex flex-col items-center h-full'>
	<!-- Corazón -->
	<div class='w-5 h-5 flex items-center justify-center z-10'>
		<svg
			xmlns='http://www.w3.org/2000/svg'
			viewBox='0 0 24 24'
			fill='#8A0F84'
			class='w-5 h-5'>
			<path
				d='M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5
				2 5.42 4.42 3 7.5 3
				c1.74 0 3.41.81 4.5 2.09
				C13.09 3.81 14.76 3 16.5 3
				19.58 3 22 5.42 22 8.5
				c0 3.78-3.4 6.86-8.55 11.54L12 21.35z'
			></path>
		</svg>
	</div>

	{!isLast && <div class='w-[2px] flex-1 bg-[#8A0F84] min-h-20' />}
</div>
