---
import ourHistoryImage from "../../../assets/1.jpg";
import ourHistoryImageTablet from "../../../assets/ourHistoryTablet.png";
---

<div>
	<div class='w-full hidden md:block lg:hidden h-[450px]'>
		<img
			class='w-full h-full object-cover object-center'
			src={ourHistoryImageTablet.src}
			alt='mobile-cover-image'
		/>
	</div>
	<div class='w-full h-[366px] md:hidden lg:block lg:h-[798px] xl:h-[899px]'>
		<img
			class='w-full h-full object-cover object-center'
			src={ourHistoryImage.src}
			alt='mobile-cover-image'
		/>
	</div>
</div>

