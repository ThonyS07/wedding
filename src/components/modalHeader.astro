---

<div class='flex justify-end w-full'>
	<button
		class='close-modal-btn p-2 text-gray-500 hover:text-gray-800 transition-colors rounded-full hover:bg-gray-100 cursor-pointer'
		aria-label='Cerrar modal'>
		<svg
			xmlns='http://www.w3.org/2000/svg'
			class='h-6 w-6'
			fill='none'
			viewBox='0 0 24 24'
			stroke='currentColor'>
			<path
				stroke-linecap='round'
				stroke-linejoin='round'
				stroke-width='2'
				d='M6 18L18 6M6 6l12 12'></path>
		</svg>
	</button>
</div>

<script>
	const closeButtons = document.querySelectorAll(".close-modal-btn");

	closeButtons.forEach((button) => {
		button.addEventListener("click", (event) => {
			event.preventDefault();

			// Intenta cerrar si es un elemento <dialog> nativo
			const dialog = button.closest("dialog");
			if (dialog) {
				dialog.close();
				return;
			}

			// Si es un div personalizado, oculta el contenedor principal del modal.
			// Asume que el padre del padre es el contenedor del modal principal,
			// o puedes agregarle la clase 'modal-wrapper' a tu modal para que sea más específico.
			const customModal =
				button.closest(".modal-wrapper") || button.parentElement?.parentElement;
			if (customModal) {
				(customModal as HTMLElement).style.display = "none";
			}
		});
	});
</script>
