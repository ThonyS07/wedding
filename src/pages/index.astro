---
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/header.astro";
import Body from "../components/sections/body.astro";
import Footer from "../components/sections/footer.astro";
import DressCodeModal from "../components/body/dressCodeModal/dressCodeModal.astro";
import CeremoniaMapModal from "../components/body/mapModal/ceremoniaMapModal.astro";
import RecepcionMapModal from "../components/body/mapModal/recepcionMapModal.astro";
import ItineraryModal from "../components/body/itineraryModal/itineraryModal.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<Header />
	<Body />
	<Footer />
	<DressCodeModal />
	<RecepcionMapModal
		lat='-12.241052387093989'
		lng='-76.88036284682182'
		zoom='16'
	/>
	<CeremoniaMapModal
		lat='-12.389635630841825'
		lng='-76.78116286393355'
		zoom='16'
	/>
	<ItineraryModal />
</Layout>
